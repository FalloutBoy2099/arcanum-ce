function(arcanum_prefer_outline_fonts source_file)
    file(LOCK "${source_file}.arcanum.lock" GUARD FUNCTION TIMEOUT 30)
    file(READ "${source_file}" original_source)
    set(default_flags "FT_LOAD_DEFAULT | font->ft_load_target")
    set(outline_flags "${default_flags} | (FT_IS_SCALABLE(font->face) ? FT_LOAD_NO_BITMAP : 0)")
    string(REPLACE "${outline_flags}" "${default_flags}" normalized_source "${original_source}")
    string(LENGTH "${normalized_source}" source_length)
    string(REPLACE "${default_flags}" "" without_flags "${normalized_source}")
    string(LENGTH "${without_flags}" without_flags_length)
    string(LENGTH "${default_flags}" flags_length)
    math(EXPR occurrence_count "(${source_length} - ${without_flags_length}) / ${flags_length}")
    if(NOT occurrence_count EQUAL 3)
        message(FATAL_ERROR "SDL_ttf outline font patch expected 3 load flag expressions, found ${occurrence_count}")
    endif()
    string(REPLACE "${default_flags}" "${outline_flags}" patched_source "${normalized_source}")
    if(NOT patched_source STREQUAL original_source)
        file(WRITE "${source_file}.arcanum.tmp" "${patched_source}")
        file(RENAME "${source_file}.arcanum.tmp" "${source_file}")
    endif()
endfunction()
