foreach(argument COUNTER_FILE OUTPUT_FILE TEMPLATE_FILE)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${argument}")
    endif()
endforeach()

get_filename_component(counter_directory "${COUNTER_FILE}" DIRECTORY)
get_filename_component(output_directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${counter_directory}" "${output_directory}")
file(LOCK "${COUNTER_FILE}.lock" GUARD PROCESS TIMEOUT 30 RESULT_VARIABLE lock_result)
if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "Cannot lock the Windows version counter: ${lock_result}")
endif()

set(build_number 0)
if(EXISTS "${COUNTER_FILE}")
    file(READ "${COUNTER_FILE}" build_number)
    string(STRIP "${build_number}" build_number)
    string(LENGTH "${build_number}" number_length)
    if(NOT build_number MATCHES "^(0|[1-9][0-9]*)$" OR number_length GREATER 10)
        message(FATAL_ERROR "Invalid Windows version counter: ${COUNTER_FILE}")
    endif()
endif()
if(build_number GREATER_EQUAL 4294967295)
    message(FATAL_ERROR "Windows version counter exhausted")
endif()

math(EXPR build_number "${build_number} + 1")
math(EXPR version_patch "${build_number} / 65536")
math(EXPR version_revision "${build_number} % 65536")
set(file_version "1.0.${version_patch}.${version_revision}")
set(version_flags "0")
if(CONFIGURATION STREQUAL "Debug")
    set(version_flags "VS_FF_DEBUG")
endif()

configure_file("${TEMPLATE_FILE}" "${OUTPUT_FILE}" @ONLY)
file(WRITE "${output_directory}/arcanum_version.txt" "${file_version}\n")
file(WRITE "${COUNTER_FILE}.tmp" "${build_number}\n")
file(RENAME "${COUNTER_FILE}.tmp" "${COUNTER_FILE}")
message(STATUS "Arcanum Windows version: ${file_version}")
